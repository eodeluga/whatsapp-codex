{
  "schemaVersion": 1,
  "responsePrefix": "[codex]",
  "helpHeading": "Commands available to WhatsApp Codex",
  "helpFooter": "Plain text during a turn steers it. When Codex asks for approval, reply with the displayed number, or /stop.",
  "groups": [
    {
      "heading": "Available from WhatsApp",
      "commands": [
        { "usage": "/", "description": "show this command catalogue" },
        { "usage": "/help", "description": "show this command catalogue" },
        { "usage": "/new", "description": "start and select a new Codex thread" },
        { "usage": "/status", "description": "show bridge, app-server, transport, thread, turn, queue, and pending request status" },
        { "usage": "/stop", "description": "interrupt the active Codex turn" },
        { "usage": "/answer <token> <answer>", "description": "answer a pending Codex question" },
        { "usage": "/whatsapp list-threads", "description": "list recent resumable Codex threads" },
        { "usage": "/whatsapp attach <thread-id>", "description": "select a normal Codex thread for WhatsApp input" }
      ]
    }
  ]
}
